{
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "github": {
    "enabled": true,
    "silent": false
  },
  "functions": {
    "src/app/api/*/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/get-landmarks/route.ts": {
      "maxDuration": 25
    },
    "src/app/api/instagram/route.ts": {
      "maxDuration": 20
    },
    "src/app/api/scrape-property/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/deploy/route.ts": {
      "maxDuration": 60
    }
  },
  "build": {
    "env": {
      "NEXT_TELEMETRY_DISABLED": "1"
    }
  },
  "crons": []
}